{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ayanshulife/lifeastroapi-mcp",
  "title": "LifeAstro — Vedic astrology & Hindu calendar",
  "description": "Vedic astrology, panchang and Hindu festival calendar: 320 tools backed by LifeAstroAPI",
  "websiteUrl": "https://lifeastroapi.com/mcp/",
  "repository": {
    "url": "https://github.com/ayanshulife/lifeastroapi-mcp",
    "source": "github"
  },
  "version": "0.11.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/ayanshulife/lifeastroapi-mcp:0.11.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LIFEASTRO_API_KEY",
          "description": "Your LifeAstroAPI key (free at https://lifeastroapi.com/signup/)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
